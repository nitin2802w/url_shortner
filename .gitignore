# =============================================================================
# Root-level .gitignore — covers both backend/ and frontend/
# =============================================================================

# ── Environment Variables (NEVER commit secrets) ──────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info/
dist/
build/
.Python
venv/
.venv/
env/

# ── Test & Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Linting & Type Checking ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
.next/
dist/
.nuxt/
.output/

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
